	@$(NORMAL_UNINSTALL)
	@list='$(pkgexample_DATA)'; test -n "$(pkgexampledir)" || list=; \
	files=`for p in $$list; do echo $$p; done | sed -e 's|^.*/||'`; \
	dir='$(DESTDIR)$(pkgexampledir)'; $(am__uninstall_files_from_dir)
install-nodist_includeHEADERS: $(nodist_include_HEADERS)
