PROJECT_NAME           = "fuzzgpu"
PROJECT_BRIEF          = "GPU fuzzing generator and difftest support"
OUTPUT_DIRECTORY       = "@DOXYGEN_OUTPUT_DIR@"
CREATE_SUBDIRS         = YES

INPUT                  = "@CMAKE_SOURCE_DIR@/README.md" \
                         "@CMAKE_SOURCE_DIR@/include" \
                         "@CMAKE_SOURCE_DIR@/src" \
                         "@CMAKE_SOURCE_DIR@/difftest-gpu/csrc/include/difftest_gpu"
RECURSIVE              = YES
FILE_PATTERNS          = *.md *.hh *.hpp *.h *.cc
EXCLUDE_PATTERNS       = */build*/* */thirdparty/* */baseline/* */targets/*
USE_MDFILE_AS_MAINPAGE = "@CMAKE_SOURCE_DIR@/README.md"

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MARKDOWN_SUPPORT       = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = @DOXYGEN_HTML_OUTPUT@
GENERATE_LATEX         = NO
GENERATE_XML           = NO
HAVE_DOT               = @DOXYGEN_HAVE_DOT@

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = NO
